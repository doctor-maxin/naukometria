{
  "name": "scientometrics",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "swc src --out-dir dist",
    "build:watch": "swc -w src --out-dir dist",
    "type-check": "tsc --noEmit",
    "dev": "npm run build && node dist/src/server.js",
    "clean": "rm -rf dist",
    "generate": "npx prisma generate --schema ./prisma/schema.prisma ",
    "migrate": "npx prisma migrate dev --schema ./prisma/schema.prisma",
    "deploy": "npx prisma migrate deploy --schema ./prisma/schema.prisma",
    "studio": "npx prisma studio --schema ./prisma/schema.prisma --port 5555"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/bun": "latest",
    "@types/dotenv": "^8.2.3",
    "dotenv": "^17.2.3",
    "prettier": "^3.7.4",
    "prisma": "^7.2.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^5.0.3",
    "@fastify/multipart": "^9.3.0",
    "@fastify/routes": "^6.0.2",
    "@fastify/static": "^9.0.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.8",
    "@types/node": "^25.0.7",
    "adm-zip": "^0.5.16",
    "bullmq": "^5.66.5",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "file-type": "^21.3.0",
    "ioredis": "^5.9.1",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3"
  },
  "trustedDependencies": [
    "@swc/core"
  ]
}
