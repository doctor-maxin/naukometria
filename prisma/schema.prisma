generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ImportProcess {
  uuid              String                 @id @default(uuid()) @db.Uuid
  filename          String
  status            ImportStatus           @default(PENDING)
  filesPath         String                 @map("files_path")
  totalArticles     Int                    @default(0) @map("total_articles")
  processedArticles Int                    @default(0) @map("processed_articles")
  failedArticles    Int                    @default(0) @map("failed_articles")
  errorMessage      String?                @map("error_message")
  startedAt         DateTime               @default(now()) @map("started_at")
  completedAt       DateTime?              @map("completed_at")
  journal           ImportProcessJournal[]
}

model ImportProcessJournal {
  uuid            String        @id @default(uuid()) @db.Uuid
  importProcess   ImportProcess @relation(fields: [importProcessId], references: [uuid], onDelete: Cascade)
  importProcessId String        @map("import_process_id") @db.Uuid
  documentBody    String?       @map("document_body") @db.Text
  errorBody       String?       @map("error_body") @db.Text
  timestamp       DateTime      @default(now())
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PublicationType {
  SCIENTIFIC_ARTICLE
  LITERATURE_REVIEW
  BOOK_REVIEW
  BIOGRAPHICAL_MATERIAL
  TRANSLATION
  EDITORIAL_MATERIAL
  RETRACTION_NOTICE
  NOTE
  NOTICE
  REQUIRES_MANUAL_CLASSIFICATION
}

model Organization {
  uuid                         String   @id @default(uuid()) @db.Uuid
  isDeleted                    Boolean  @map("is_deleted")
  tsCreated                    DateTime @default(now()) @map("ts_created")
  updatedAt                    DateTime @updatedAt @map("updated_at")
  title                        String   @map("title")
  fullTitle                    String   @map("full_title")
  titleEn                      String   @map("title_en")
  titleNativeLang              String   @map("title_native_lang")
  uuidLocalChurch              String?  @map("uuid_local_church")
  uuidDiocese                  String?  @map("uuid_diocese")
  links                        Json?    @map("links")
  offsiteLink                  String?  @map("offsite_link")
  uchkomSiteLink               String?  @map("uchkom_site_link")
  uchkomRatingLink             String?  @map("uchkom_rating_link")
  uuidAttachment               String?  @map("uuid_attachment")
  slug                         String   @unique @map("slug")
  systemId                     String   @map("system_id")
  altTitle                     String?  @map("alt_title")
  rating                       Float?   @map("rating")
  previousRating               Float?   @map("previous_rating")
  ratingNum                    Float?   @map("rating_num")
  uuidImagePreview             String?  @map("uuid_image_preview")
  uuidVocOrganizationType      String?  @map("uuid_voc_organization_type")
  uuidVocEducationInstType     String?  @map("uuid_voc_education_inst_type")
  uuidVocEducationLevel        String?  @map("uuid_voc_education_level")
  uuidVocConfession            String?  @map("uuid_voc_confession")
  ogrn                         String?  @map("ogrn")
  inn                          String?  @map("inn")
  kpp                          String?  @map("kpp")
  rinc                         String?  @map("rinc")
  establishmentYear            Int?     @map("establishment_year")
  uuidVocCountry               String?  @map("uuid_voc_country")
  uuidVocFederalDistrict       String?  @map("uuid_voc_federal_district")
  uuidVocRegion                String?  @map("uuid_voc_region")
  postcode                     Int?     @map("postcode")
  uuidVocCity                  String?  @map("uuid_voc_city")
  address                      String?  @map("address")
  officePhone                  String?  @map("office_phone")
  officeFax                    String?  @map("office_fax")
  officeEmail                  String?  @map("office_email")
  directorOfficePhone          String?  @map("director_office_phone")
  directorOfficeFax            String?  @map("director_office_fax")
  directorOfficeEmail          String?  @map("director_office_email")
  rectorOfficeEmail            String?  @map("rector_office_email")
  admissionOfficeEmail         String?  @map("admission_office_email")
  isChurchAccreditation        Boolean  @map("is_church_accreditation")
  isGovernmentAccreditation    Boolean  @map("is_government_accreditation")
  uuidVocJurisdiction          String?  @map("uuid_voc_jurisdiction")
  uuidVocSubordination         String?  @map("uuid_voc_subordination")
  uuidVocTheologicalDepartment String?  @map("uuid_voc_theological_department")
  uuidVocDiplomaType           String?  @map("uuid_voc_diploma_type")
  uuidVocDiplomaClassification String?  @map("uuid_voc_diploma_classification")
  admission                    String?  @map("admission")
  shortDescription             String?  @map("short_description")
  educationDuration            Float?   @map("education_duration")
  uuidVocEducationFormat       String?  @map("uuid_voc_education_format")
  isRightToPriesthood          Boolean  @map("is_right_to_priesthood")
  uuidHeadPerson               String?  @map("uuid_head_person")
  headPhone                    String?  @map("head_phone")
  headEmail                    String?  @map("head_email")
  headLink                     String?  @map("head_link")
  mainDescription              String?  @map("main_description")
  additionalDescription        String?  @map("additional_description")
  isActive                     Boolean  @default(false) @map("is_active")
  isDisplayOnLanding           Boolean  @default(true) @map("is_display_on_landing")
  totalViews                   Int      @default(0) @map("total_views")

  oldId              Int?      @map("old_id")
  oldStart           DateTime? @map("old_start")
  oldFinish          DateTime? @map("old_finish")
  oldIsImportant     Boolean?  @map("old_is_important")
  oldAnnotation      String?   @map("old_annotation")
  oldText            String?   @map("old_text")
  oldStatus          String?   @map("old_status")
  oldCommentsForm    Boolean?  @map("old_comments_form")
  oldTopics          Json?     @map("old_topics")
  oldConfessions     Json?     @map("old_confessions")
  oldGenres          Json?     @map("old_genres")
  oldKeywords        Json?     @map("old_keywords")
  oldGeography       Json?     @map("old_geography")
  oldPublicationTime DateTime? @map("old_publication_time")
  oldMainLanguage    Int?      @map("old_main_language")
  oldLanguage        Int?      @map("old_language")
  oldTranslatedFrom  Int?      @map("old_translated_from")
  oldSmallImage      Int?      @map("old_small_image")
  oldHeadImage       Int?      @map("old_head_image")
  oldHeadImage2      Int?      @map("old_head_image2")
  oldImgComment      String?   @map("old_img_comment")
  oldNumchar         Int?      @map("old_numchar")

  @@map("organizations")
}

model Publication {
  uuid   String  @id @default(uuid()) @db.Uuid
  rincId String? @map("rinc_id")

  type          PublicationType
  isManuallySet Boolean         @default(false) @map("is_manually_set")

  title           String
  authors         String[]
  organizations   String[]
  publishingHouse String?   @map("publishing_house")
  journalIssue    String?   @map("journal_issue")
  pages           String?
  publicationYear DateTime? @map("publication_year")
  citations       String?
  language        String?
  doi             String?
  edn             String?
  keywords        String?
  description     String?
  bibliography    String[]
  fundingSource   String?   @map("funding_source")
  sourceLink      String?   @map("source_link")
  textLink        String?   @map("text_link")
  attachmentUuid  String?   @map("attachment_uuid")
  totalCitations  Int?      @map("total_citations")
  rubrics         String[]
  isFullText      Boolean?  @map("is_full_text")
  isNew           Boolean?  @map("is_new")
  isActive        Boolean   @default(true) @map("is_active")

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  rincArticles RincArticle[]

  @@map("publications")
}

model RincArticle {
  id                String      @id @default(uuid()) @db.Uuid
  publicationUuid   String      @map("publication_uuid") @db.Uuid
  processImportUuid String      @map("process_import_uuid") @db.Uuid
  publication       Publication @relation(fields: [publicationUuid], references: [uuid], onDelete: Cascade)
  rawData           Json        @map("raw_data") // Исходные данные JSON из РИНЦ
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
}

model Author {
  uuid                       String    @id @default(uuid()) @db.Uuid
  lastName                   String    @map("last_name")
  lastNameFrom               String?   @map("last_name_from")
  firstName                  String?   @map("first_name")
  middleName                 String?   @map("middle_name")
  altName                    String?   @map("alt_name")
  latName                    String?   @map("lat_name")
  monasticName               String?   @map("monastic_name")
  label                      String?   @map("label")
  isHolyRank                 Boolean   @default(false) @map("is_holy_rank")
  uuidVocHierarchicalDegrees String?   @map("uuid_voc_hierarchical_degrees")
  orcidId                    String?   @map("orcid_id")
  rinc                       String?   @map("rinc")
  spinElibId                 Int?      @map("spin_elib_id")
  totalMaterialsElib         Int?      @map("total_materials_elib")
  totalQuotesElib            Int?      @map("total_quotes_elib")
  hIndexElib                 Int?      @map("h_index_elib")
  uuidAcademicTitle          String?   @map("uuid_academic_title")
  uuidImagePreview           String?   @map("uuid_image_preview")
  uuidVocConfession          String?   @map("uuid_voc_confession")
  uuidDiocese                String?   @map("uuid_diocese")
  links                      Json?     @map("links")
  uuidPhoto                  String?   @map("uuid_photo")
  isDeleted                  Boolean   @default(false) @map("is_deleted")
  tsCreated                  DateTime  @default(now()) @map("ts_created")
  uuidUser                   String?   @map("uuid_user")
  description                String?   @map("description")
  mainDescription            String?   @map("main_description")
  extraDescription           String?   @map("extra_description")
  anons                      String?   @map("anons")
  birthday                   DateTime? @map("birthday")
  deathdate                  DateTime? @map("deathdate")
  uuidVocCountry             String?   @map("uuid_voc_country")
  externalId                 String    @map("external_id")
  updatedAt                  DateTime  @updatedAt @map("updated_at")
  isActive                   Boolean   @default(true) @map("is_active")
  isBeforeBc                 Boolean   @default(false) @map("is_before_bc")
  isNotExactBirth            Boolean   @default(false) @map("is_not_exact_birth")
  isSuper                    Boolean   @default(false) @map("is_super")
  isOnListPageBanner         Boolean   @default(true) @map("is_on_list_page_banner")

  tabJobs                Boolean @default(false) @map("tab_jobs")
  tabScientificInterests Boolean @default(false) @map("tab_scientific_interests")
  tabEducation           Boolean @default(false) @map("tab_education")
  tabDissertations       Boolean @default(false) @map("tab_dissertations")
  tabAwards              Boolean @default(false) @map("tab_awards")

  scientificInterestsText String? @map("scientific_interests_text")

  slug       String @unique @map("slug")
  totalViews Int    @default(0) @map("total_views")

  oldId                      Int?      @map("old_id")
  oldStatus                  String?   @map("old_status")
  oldTitle                   String?   @map("old_title")
  oldImage                   Int?      @map("old_image")
  oldSmallImage              Int?      @map("old_small_image")
  oldHeadImage               Int?      @map("old_head_image")
  oldHeadImage2              Int?      @map("old_head_image2")
  oldImgComment              String?   @map("old_img_comment")
  oldNumchar                 Int?      @map("old_numchar")
  oldProfInterests           Json?     @map("old_prof_interests")
  oldAcademicRanks           Json?     @map("old_academic_ranks")
  oldAcademicRanksText       String?   @map("old_academic_ranks_text")
  oldAwards                  String?   @map("old_awards")
  oldBibliographyAbout       String?   @map("old_bibliography_about")
  oldBibliographyOf          String?   @map("old_bibliography_of")
  oldBibliographyOfOrig      String?   @map("old_bibliography_of_orig")
  oldContacts                String?   @map("old_contacts")
  oldEmploymentText          String?   @map("old_employment_text")
  oldNameOrgLang             String?   @map("old_name_org_lang")
  oldNameRus                 String?   @map("old_name_rus")
  oldScientificInterestsText String?   @map("old_scientific_interests_text")
  oldSourceText              String?   @map("old_source_text")
  oldStart                   DateTime? @map("old_start")
  oldFinish                  DateTime? @map("old_finish")
  oldIsPersonalia            Boolean?  @map("old_is_personalia")
  oldKeywords                Json?     @map("old_keywords")
  oldGeography               Json?     @map("old_geography")
  oldPublicationTime         DateTime? @map("old_publication_time")
  oldMainLanguage            Int?      @map("old_main_language")
  oldLanguage                Int?      @map("old_language")
  oldTranslatedFrom          Int?      @map("old_translated_from")

  uuidPersonDraft String? @map("uuid_person_draft")

  @@map("persons")
}

model Journal {
  uuid                       String   @id @default(uuid()) @db.Uuid
  isDeleted                  Boolean  @default(false) @map("is_deleted")
  tsCreated                  DateTime @default(now()) @map("ts_created")
  titleMain                  String   @map("title_main")
  titleExtra                 String?  @map("title_extra")
  titleOld                   String?  @map("title_old")
  titleShort                 String?  @map("title_short")
  issn                       String?  @map("issn")
  issnL                      String?  @map("issn_l")
  eIssn                      String?  @map("e_issn")
  elibraryId                 String?  @map("elibrary_id")
  scopusId                   String?  @map("scopus_id")
  isGeneralChurchRecommended Boolean  @default(false) @map("is_general_church_recommended")
  sinceYearIndex             Int?     @map("since_year_index")
  establishmentYear          Int?     @map("establishment_year")
  closingYear                Int?     @map("closing_year")
  publishingCountry          String?  @map("publishing_country")
  publishingLanguage         String?  @map("publishing_language")
  uuidImagePreview           String?  @map("uuid_image_preview")
  slug                       String   @unique @map("slug")
  doi                        String?  @map("doi")
  description                String?  @map("description")
  totalIssues                Int?     @map("total_issues")
  siteUrl                    String?  @map("site_url")
  rincUrl                    String?  @map("rinc_url")
  oecd                       Json?    @map("oecd")
  isActive                   Boolean  @default(false) @map("is_active")
  rinc                       String?  @map("rinc")
  uuidVocCountry             String?  @map("uuid_voc_country")
  publishingStartYear        String?  @map("publishing_start_year")
  publishingEndYear          String?  @map("publishing_end_year")
  isDefault                  Boolean  @default(false) @map("is_default")

  @@map("journals")
}
