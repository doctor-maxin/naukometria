generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ImportProcess {
  uuid              String                 @id @default(uuid()) @db.Uuid
  filename          String
  status            ImportStatus           @default(PENDING)
  filesPath         String
  totalArticles     Int                    @default(0)
  processedArticles Int                    @default(0)
  failedArticles    Int                    @default(0)
  errorMessage      String?
  startedAt         DateTime               @default(now())
  completedAt       DateTime?
  journal           ImportProcessJournal[]
}

model ImportProcessJournal {
  id              String        @id @default(uuid()) @db.Uuid
  importProcess   ImportProcess @relation(fields: [importProcessId], references: [uuid], onDelete: Cascade)
  importProcessId String        @db.Uuid
  documentBody    String?       @db.Text
  errorBody       String?       @db.Text
  timestamp       DateTime      @default(now())
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

